---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const leagues = ['NFL', 'NBA', 'MLB', 'NHL', 'NCAA', 'Fantasy'];
---
<BaseLayout
  title="SportsRulesDesk | NFL, NBA & Fantasy Rules Explained"
  description="Clear, accurate explanations of NFL, NBA, MLB, NHL and Fantasy sports rules. No jargon, no fluff, just the ruling."
  current="home"
>
  <div class="wrap">
    <section class="hero">
      <span class="hero-eyebrow">Rules, not rumors</span>
      <h1>Every sports rule explained in plain English.</h1>
      <p>
        SportsRulesDesk breaks down how NFL, NBA, MLB, NHL, NCAA and Fantasy rules
        actually work, straight from the rulebook, with no jargon and no live-score noise.
      </p>

      <div class="league-strip">
        {leagues.map(l => (
          <span class={`league-chip ${l}`}>{l}</span>
        ))}
      </div>
    </section>

    <div class="grid">
      {posts.map(post => (
        <a href={`/posts/${post.id}/`} class="card" style="text-decoration:none;">
          <span class="card-meta">
            <span class={`league-chip ${post.data.league}`}>{post.data.league}</span>
          </span>
          <h3>{post.data.title}</h3>
          <p>{post.data.metaDescription}</p>
          <div class="card-ruling">{post.data.ruling}</div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
